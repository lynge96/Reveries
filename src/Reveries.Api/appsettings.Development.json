{
  "ConnectionStrings": {
    "ReveriesDb": "Host=localhost;Port=5432;Database=reveries_db;Username=reveries_user;Password=;CommandTimeout=20"
  },
  "Loki": {
    "Uri": "http://raspberrypi:3100"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Information",
        "Npgsql": "Information",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      }
    ]
  },
  "OpenApi": {
    "Servers": [
      {
        "Url": "https://localhost:7238",
        "Description": "Local Development"
      },
      {
        "Url": "https://api.reveries.dk",
        "Description": "Production"
      }
    ]
  }
}
