{
  "openapi": "3.1.1",
  "info": {
    "title": "Reveries API",
    "description": "REST API for the Reveries book catalog.",
    "version": "v1"
  },
  "paths": {
    "/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get all books",
        "description": "Fetches every book in the database",
        "operationId": "GetAllBooks",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookCollectionResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Add book",
        "description": "Adds a new book to the database",
        "operationId": "CreateBook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateBookResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/books/isbn/{isbn}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get book by ISBN",
        "description": "Fetches a specific book by ISBN from external APIs, the cache or the database. Returns 404 when no book is found.",
        "operationId": "GetBookByIsbn",
        "parameters": [
          {
            "name": "isbn",
            "in": "path",
            "description": "ISBN-10 or ISBN-13 of the edition.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/books/isbn/{isbn}/exists": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Check book exists",
        "description": "Checks if a book with the specified ISBN exists in the database",
        "operationId": "BookExists",
        "parameters": [
          {
            "name": "isbn",
            "in": "path",
            "description": "ISBN-10 or ISBN-13 of the edition.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookExistsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/books/isbns": {
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Get books by ISBNs",
        "description": "Looks up multiple books by ISBN from external APIs, the cache or the database. Returns 404 when none of the ISBNs resolve to a book.",
        "operationId": "GetBooksByIsbns",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookLookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookCollectionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookCollectionResponse": {
        "type": "object",
        "properties": {
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of books in the response.",
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookResponse"
            },
            "description": "The books returned by the request."
          }
        }
      },
      "BookExistsResponse": {
        "required": [
          "exists"
        ],
        "type": "object",
        "properties": {
          "exists": {
            "type": "boolean",
            "description": "True when a book with the given ISBN exists in the catalog."
          }
        }
      },
      "BookLookupRequest": {
        "required": [
          "isbns"
        ],
        "type": "object",
        "properties": {
          "isbns": {
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "ISBNs to look up (ISBN-10 or ISBN-13). Between 1 and 100 entries."
          }
        }
      },
      "BookResponse": {
        "required": [
          "bookId",
          "title"
        ],
        "type": "object",
        "properties": {
          "bookId": {
            "type": "string",
            "description": "Identifier of the edition.",
            "format": "uuid"
          },
          "isbn10": {
            "type": [
              "null",
              "string"
            ],
            "description": "ISBN-10 of the edition, when available."
          },
          "isbn13": {
            "type": [
              "null",
              "string"
            ],
            "description": "ISBN-13 of the edition, when available."
          },
          "title": {
            "type": "string",
            "description": "Primary title of the work."
          },
          "subtitle": {
            "type": [
              "null",
              "string"
            ],
            "description": "Secondary title shown after the main title."
          },
          "authors": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Author names in display order."
          },
          "publisher": {
            "type": [
              "null",
              "string"
            ],
            "description": "Name of the publisher of this edition."
          },
          "language": {
            "type": [
              "null",
              "string"
            ],
            "description": "Language of the edition as an ISO code or name."
          },
          "pages": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "Number of pages in the edition.",
            "format": "int32"
          },
          "publicationDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "Publication date as free-form text."
          },
          "synopsis": {
            "type": [
              "null",
              "string"
            ],
            "description": "Short synopsis of the work."
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "Longer description of the edition."
          },
          "format": {
            "type": [
              "null",
              "string"
            ],
            "description": "Physical format or binding (e.g. 'Hardcover', 'Paperback')."
          },
          "edition": {
            "type": [
              "null",
              "string"
            ],
            "description": "Edition statement (e.g. '2nd edition')."
          },
          "imageThumbnailUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "URL of a small cover thumbnail."
          },
          "coverImageUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "URL of the full-size cover image."
          },
          "saxoUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "Deep link to the edition's product page on Saxo."
          },
          "weightG": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Weight of the physical edition in grams.",
            "format": "double"
          },
          "heightCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Height of the physical edition in centimeters.",
            "format": "double"
          },
          "widthCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Width of the physical edition in centimeters.",
            "format": "double"
          },
          "thicknessCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Thickness (spine) of the physical edition in centimeters.",
            "format": "double"
          },
          "deweyDecimals": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Dewey Decimal classification codes."
          },
          "primaryGenres": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Primary genres of the work."
          },
          "secondaryGenres": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Secondary genres of the work."
          }
        }
      },
      "CreateBookRequest": {
        "required": [
          "title"
        ],
        "type": "object",
        "properties": {
          "isbn10": {
            "type": [
              "null",
              "string"
            ],
            "description": "ISBN-10 of the edition. Provide this or isbn13; isbn13 takes precedence when both are set."
          },
          "isbn13": {
            "type": [
              "null",
              "string"
            ],
            "description": "ISBN-13 of the edition. Provide this or isbn10; takes precedence when both are set."
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
            "description": "Primary title of the work."
          },
          "subtitle": {
            "type": [
              "null",
              "string"
            ],
            "description": "Secondary title shown after the main title."
          },
          "authors": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Author names in display order."
          },
          "publisher": {
            "type": [
              "null",
              "string"
            ],
            "description": "Name of the publisher of this edition."
          },
          "language": {
            "type": [
              "null",
              "string"
            ],
            "description": "Language of the edition as an ISO code or name (e.g. 'en', 'da')."
          },
          "pages": {
            "maximum": 100000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "Number of pages in the edition.",
            "format": "int32"
          },
          "publicationDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "Publication date as free-form text (e.g. '2008' or '2008-10-15')."
          },
          "synopsis": {
            "type": [
              "null",
              "string"
            ],
            "description": "Short synopsis of the work."
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "Longer description of the edition."
          },
          "format": {
            "type": [
              "null",
              "string"
            ],
            "description": "Physical format or binding (e.g. 'Hardcover', 'Paperback')."
          },
          "edition": {
            "type": [
              "null",
              "string"
            ],
            "description": "Edition statement (e.g. '2nd edition')."
          },
          "imageThumbnail": {
            "type": [
              "null",
              "string"
            ],
            "description": "URL of a small cover thumbnail."
          },
          "imageUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "URL of the full-size cover image."
          },
          "heightCm": {
            "maximum": 1000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Height of the physical edition in centimeters.",
            "format": "double"
          },
          "widthCm": {
            "maximum": 1000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Width of the physical edition in centimeters.",
            "format": "double"
          },
          "thicknessCm": {
            "maximum": 1000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Thickness (spine) of the physical edition in centimeters.",
            "format": "double"
          },
          "weightG": {
            "maximum": 100000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Weight of the physical edition in grams.",
            "format": "double"
          },
          "deweyDecimals": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Dewey Decimal classification codes."
          },
          "primaryGenres": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Primary genres of the work."
          },
          "secondaryGenres": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Secondary genres of the work."
          }
        }
      },
      "CreateBookResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the created edition.",
            "format": "uuid"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Books",
      "description": "Catalog books: look up editions by ISBN, enrich them from external sources, and store them."
    }
  ]
}