<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
    <StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Quick.AspNetCore.Components.Web.Extensions" Version="6.0.2" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="..\..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
    <Content Update="wwwroot\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="GenerateApiModels">
    <Exec Command="dotnet tool restore" />
    <Exec Command="dotnet nswag openapi2csclient /input:&quot;$(MSBuildProjectDirectory)/../Reveries.Api/openapi.json&quot; /classStyle:Poco /generateClientClasses:false /generateExceptionClasses:false /generateNullableReferenceTypes:true /jsonLibrary:SystemTextJson /namespace:Reveries.Blazor.BookScanner.ApiContracts /output:&quot;$(MSBuildProjectDirectory)/Generated/ApiContracts.g.cs&quot;" />
  </Target>

</Project>
